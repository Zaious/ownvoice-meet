# Development only. Copy to .env.local (git-ignored) and fill in.
# Named without a leading dot so tools that guard .env* files never mistake the template for secrets.
# Debug builds read .env.local at startup; release builds never do.
# End users enter keys in the Settings window instead (stored in the OS keychain).
# A key set in the Settings window takes precedence over these.

# Translation and replies (Claude). Get a key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Listening with gpt-4o-mini-transcribe / gpt-live-transcribe, translation with gpt-6-luna / gpt-6.1-sol
# Get a key: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# Listening with Gemini 3.5 Transcribe Live, translation with Gemini Flash-Lite / Flash.
# Use a paid-tier key: free-tier data is used to improve Google's products.
# Get a key: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
